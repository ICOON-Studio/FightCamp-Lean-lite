{
  "answers": {
    "q10": {
      "answer": "set_blend_time('P60','M60',0.40) overrides the default 0.10s. play('M60') with no custom blend takes 0.40s.",
      "source": [
        "scene/animation/animation_player.cpp:426-442"
      ],
      "measured": "Blend settles at -60deg at t=0.40s (24 steps). The pair blend time (0.40s) is used, not the default (0.10s).",
      "claim": {
        "completes_at_s": 0.4
      }
    },
    "q11": {
      "answer": "No jump. When P60_SHORT ends mid-blend at t=0.10s, it holds its last frame (+60deg). The blend continues smoothly toward M60 (-60deg) with no discontinuity.",
      "source": [
        "scene/animation/animation_player.cpp:226"
      ],
      "measured": "Max step-jump during (0.10,0.25] is 8.57deg, same as before 0.10s. The outgoing clip holds its last frame; the blend weight continues to transition.",
      "claim": {
        "jumps_when_outgoing_ends": false
      }
    },
    "q12": {
      "answer": "animation_finished fires. With advance(1/60) stepping, the signal fires at t=0.30s (step 18), exactly when the 0.30s clip reaches its end.",
      "source": [
        "scene/animation/animation_player.cpp:258",
        "scene/animation/animation_player.cpp:272"
      ],
      "measured": "Signal fires at t=0.30s (18 steps * 1/60). The signal is emitted during advance() when the playback position reaches the clip length.",
      "claim": {
        "fires": true
      }
    },
    "q8": {
      "answer": "custom_speed=0.5 does NOT stretch the blend. The 0.25s blend completes at 0.25s. The clip plays at half speed, but the blend duration is controlled by custom_blend, not custom_speed.",
      "source": [
        "scene/animation/animation_player.cpp:427",
        "scene/animation/animation_player.cpp:453"
      ],
      "measured": "Blend settles at -60deg at t=0.25s (15 steps). custom_speed=0.5 scales the clip playback but not the blend weight transition.",
      "claim": {
        "blend_scaled_by_custom_speed": false,
        "completes_at_s": 0.25
      }
    },
    "q9": {
      "answer": "No freeze frames. When P60_SHORT ends at t=0.30s, Z0_LOOP arrives with a 0.25s blend (not a cut). The angle reaches 0deg at t=0.55s.",
      "source": [
        "scene/animation/animation_player.cpp:365-370",
        "scene/animation/animation_player.cpp:258-260"
      ],
      "measured": "0 frames hold +60deg after t=0.30s. The queued loop blends in over 0.25s, reaching 0deg at t=0.55s.",
      "claim": {
        "blends_in": true,
        "freeze_frames": 0
      }
    }
  },
