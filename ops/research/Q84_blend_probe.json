{
  "answers": {
    "q1": {
      "answer": "Blend weight is linear in time; the per-bone rotation is a quaternion slerp via interpolate_via_rest.",
      "source": [
        "scene/animation/animation_player.cpp:293",
        "scene/animation/animation_mixer.cpp:1508",
        "scene/resources/animation.h:539"
      ],
      "measured": "P60(+60) to M60(-60) with blend 0.50s: angle passes through 0deg at t=0.25s (exact midpoint), settles at -60deg by t=0.50s.",
      "claim": {
        "linear_weight": true,
        "completes_at_s": 0.5
      }
    },
    "q2": {
      "answer": "The outgoing clip keeps advancing during the blend; it is NOT frozen at the moment of the call.",
      "source": [
        "scene/animation/animation_player.cpp:300"
      ],
      "measured": "RAMP at +15deg then play H15(0.25): angle deviates +6deg from +15 during the blend (peak 21deg at t=0.133s), proving RAMP continues advancing.",
      "claim": {
        "outgoing_advances": true
      }
    },
    "q3": {
      "answer": "A second play mid-blend does NOT snap; C blends from the mixed A+B pose with no discontinuity.",
      "source": [
        "scene/animation/animation_player.cpp:500",
        "scene/animation/animation_player.cpp:293"
      ],
      "measured": "P60->M60 blend, then at t=0.10s play Z0(0.25): largest step after call ~3.3deg vs largest step before ~8.6deg; ratio < 2 so no snap.",
      "claim": {
        "snaps": false
      }
    },
    "q4": {
      "answer": "seek(t, true) immediately after play(B, blend) does NOT snap; the first sample after the seek stays at the pre-call angle.",
      "source": [
        "scene/animation/animation_player.cpp:712",
        "scene/animation/animation_player.cpp:683"
      ],
      "measured": "P60 at +60deg, play RAMP(0.25) then seek(0.5, true): first sample after seek = 60.0deg (unchanged from pre-call).",
      "claim": {
        "snaps": false
      }
    },
    "q5": {
      "answer": "speed_scale stretches the blend duration inversely: at speed 0.5 the blend takes 0.50s instead of 0.25s.",
      "source": [
        "scene/animation/animation_player.cpp:293"
      ],
      "measured": "As q1 but speed_scale=0.5: angle settles at -60deg at t=1.00s (exactly blend_s / speed_scale = 0.50 / 0.5).",
      "claim": {
        "blend_scaled_by_speed": true
      }
    },
    "q6": {
      "answer": "play_with_capture and playback_auto_capture target value tracks; bone rotation tracks (TYPE_ROTATION_3D) use a separate transform-track path and are not captured.",
      "source": [
        "scene/animation/animation_mixer.cpp:1018",
        "scene/animation/animation_mixer.cpp:1508"
      ],
      "measured": "Not measured by probe (capture not applicable to TYPE_ROTATION_3D bone tracks in the AnimationPlayer blend path).",
      "claim": {
        "applies_to_bone_rotation": false
      }
    },
    "q7": {
      "answer": "No inertialization is present in Godot 4.7.2 AnimationMixer, AnimationPlayer, AnimationBlendTree, or AnimationNodeStateMachine.",
      "source": [
        "scene/animation/animation_mixer.cpp:1",
        "scene/animation/animation_player.cpp:1",
        "scene/animation/animation_blend_tree.cpp:1",
        "scene/animation/animation_node_state_machine.cpp:1"
      ],
      "measured": "Not applicable (source-only question). Searched all four files; no function, class or comment matching inertialization found.",
      "claim": {
        "inertialization_present": false
      }
    }
  },
