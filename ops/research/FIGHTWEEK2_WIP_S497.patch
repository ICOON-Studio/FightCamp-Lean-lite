 	drive_t = float(drive_for[2]) if drive_v > 0.0 else 0.0
@@ -274,7 +278,17 @@ func _apply(skel: Skeleton3D, t: float, ramp: float) -> void:
 	if drive and _hit_w.is_finite() and t > _contact and _prev_g.is_finite() and _aim_w.is_finite():
 		# Review round 2 (hit_carry_test only=pro_right_cross: the clip's glove is still 0.3-0.5 m past her face when the
 		# weight goes; let go there, the glove jumped 0.29 m through her head). It lets go as the clip's glove comes back.
-		_w_now = maxf(_w_now, clampf((_prev_g.distance_to(_aim_w) - RELEASE_M.x) / (RELEASE_M.y - RELEASE_M.x), 0.0, 1.0))
+		# S497 (both blind critics: "arms parked at full extension"; the played cross's weight read 1.0 -> 0.72 -> 0.95, the
+		# glove on her until the clip ended, 14 frames): the hold was by distance alone, so a glove that had come back and
+		# went on home was "far" again and was pinned back on her. One way now: once the clip's glove is coming back and is
+		# inside the carry on the punch line, the hold only falls, over HOME_S (real time). `-- norehold` = the control arm.
+		var out_m := (_prev_g - _aim_w).dot(_dir_w)
+		_out_max = maxf(_out_max, out_m)
